    "tokenizer",
    "bpe"
  ],
  "author": "Wattson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatde/tokenshrink.git"
  },
  "homepage": "https://tokenshrink.com",
  "engines": {
    "node": ">=16.0.0"
